<view wx:if="{{merchant}}" class="detail"><image class="cover" src="{{merchant.image}}" mode="aspectFill"/><view class="content"><text class="name">{{merchant.name}}</text><text class="meta">{{merchant.category}} · {{merchant.district}} · ★ {{merchant.score}}</text><view class="line"></view><text class="title">商户介绍</text><text class="intro">{{merchant.intro}}</text><text class="title">服务项目</text><view class="service">专业服务咨询 <text>参考价 ¥99 起</text></view></view><view class="actions"><button bindtap="call">电话咨询</button><button class="primary" bindtap="navigate">导航到店</button></view></view>
