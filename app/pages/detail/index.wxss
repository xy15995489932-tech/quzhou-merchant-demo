.detail{min-height:100vh;background:#f7f9fc}.cover{width:100%;height:430rpx}.content{margin-top:-25rpx;position:relative;padding:32rpx 30rpx 160rpx;border-radius:24rpx 24rpx 0 0;background:#fff}.name{display:block;font-size:38rpx;font-weight:800}.meta{display:block;margin-top:16rpx;color:#6f7c91;font-size:24rpx}.line{height:1rpx;margin:30rpx 0;background:#edf0f5}.title{display:block;margin:28rpx 0 13rpx;font-size:29rpx;font-weight:700}.intro{color:#69758a;line-height:1.8;font-size:25rpx}.service{padding:22rpx;border-radius:14rpx;background:#f4f8ff;color:#263858}.service text{float:right;color:#1a70ef}.actions{position:fixed;bottom:0;left:0;right:0;display:flex;gap:18rpx;padding:18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff}.actions button{flex:1;margin:0;border-radius:40rpx;color:#246fe9;background:#edf5ff;font-size:28rpx}.actions .primary{color:#fff;background:#176ff1}
