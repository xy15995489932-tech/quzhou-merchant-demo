.list-page{min-height:100vh;padding:40rpx 30rpx;background:#f7f9fc}.list-nav{font-size:34rpx;font-weight:700}.list-nav text{margin-left:18rpx}.result{margin:34rpx 0 18rpx;color:#647187;font-size:24rpx}.list-card{display:flex;gap:20rpx;margin-bottom:20rpx;padding:16rpx;background:#fff;border-radius:18rpx}.list-card image{width:190rpx;height:154rpx;border-radius:12rpx}.list-card view{display:flex;flex:1;min-width:0;flex-direction:column;gap:10rpx;color:#778397;font-size:22rpx}.name{color:#1b2941;font-size:30rpx;font-weight:700}.intro{display:-webkit-box;overflow:hidden;color:#8c96a7;-webkit-line-clamp:2;-webkit-box-orient:vertical}.score{color:#ff9c25}.empty{text-align:center;padding:100rpx 0;color:#94a0b3}
