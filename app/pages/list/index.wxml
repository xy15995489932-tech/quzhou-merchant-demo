<view class="list-page"><view class="list-nav">〈 <text>商户列表</text></view><view class="result">{{keyword ? '“' + keyword + '” 的搜索结果' : '全部优质商户'}}</view><view class="list-card" wx:for="{{merchants}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail"><image src="{{item.image}}" mode="aspectFill"/><view><text class="name">{{item.name}}</text><text>{{item.category}} · {{item.district}}</text><text class="intro">{{item.intro}}</text><text class="score">★ {{item.score}} 好评</text></view></view><view wx:if="{{!merchants.length}}" class="empty">未找到相关商户，试试其他关键词</view></view>
