.page { min-height: 100vh; background: #fff; }
.hero-shell { padding: 0 30rpx 30rpx; background: linear-gradient(180deg, #e9f5ff 0%, #f9fcff 94%, #fff 100%); }
.status-space { height: 64rpx; }.topline { height: 94rpx; display: flex; align-items: center; gap: 22rpx; }
.city { display: flex; align-items: center; gap: 7rpx; font-weight: 700; font-size: 29rpx; white-space: nowrap; }.city-pin { color: #1873f6; font-size: 38rpx; }.arrow { font-size: 21rpx; }
.search { flex: 1; height: 66rpx; display: flex; align-items: center; gap: 12rpx; padding: 0 18rpx; border: 2rpx solid #dde7f3; border-radius: 40rpx; background: #fff; color: #99a6b8; font-size: 38rpx; }.search input { flex: 1; min-width: 0; color: #26364d; font-size: 25rpx; }.search-go { padding-left: 8rpx; font-size: 22rpx; color: #2877f7; }
.banner { position: relative; overflow: hidden; height: 270rpx; padding: 46rpx 40rpx; border-radius: 22rpx; color: #fff; background: linear-gradient(125deg, #0759ef 0%, #128df8 65%, #2dbcf3 100%); box-shadow: 0 12rpx 26rpx rgba(18, 110, 240, .18); }.banner:after { content: ''; position: absolute; width: 270rpx; height: 270rpx; right: -80rpx; bottom: -80rpx; border: 7rpx solid rgba(255,255,255,.23); border-radius: 50%; }.banner-copy { position: relative; z-index: 1; }.banner-title { display:block; font-size: 44rpx; line-height: 1.22; font-weight: 800; letter-spacing: 1rpx; }.banner-sub { display:block; margin-top: 20rpx; font-size: 25rpx; }.banner-scene { position:absolute; right:46rpx; bottom:45rpx; z-index:1; color:#f6d541; font-size:75rpx; transform:rotate(-5deg); }.banner-scene text + text { color:#fff; margin-left:16rpx; }.dots { position:absolute; z-index:2; bottom:22rpx; left:50%; display:flex; gap:8rpx; transform:translateX(-50%); }.dots text { width:9rpx; height:9rpx; border-radius:9rpx; background:rgba(255,255,255,.55); }.dots .active { width:23rpx; background:#fff; }
.category-grid { display:grid; grid-template-columns:repeat(4, 1fr); padding: 30rpx 28rpx 22rpx; row-gap: 29rpx; }.category { display:flex; flex-direction:column; align-items:center; gap:11rpx; color:#233149; font-size:24rpx; font-weight:600; }.category-icon { display:flex; align-items:center; justify-content:center; width:82rpx; height:82rpx; border-radius:26rpx; color:#fff; font-size:43rpx; box-shadow: inset 0 -7rpx 0 rgba(0,0,0,.08), 0 7rpx 12rpx rgba(8,92,175,.11); }.cyan{background:#18c3c9}.pink{background:#ec45ad}.blue{background:#2f9af0}.orange{background:#ff8a2b}.sky{background:#1fb2d9}.green{background:#18b669}.yellow{background:#ffb21b}.purple{background:#5b70e9}
.section-head { display:flex; align-items:center; justify-content:space-between; margin: 36rpx 30rpx 23rpx; }.section-title { display:flex; gap:16rpx; align-items:center; font-size:37rpx; font-weight:800; }.section-title text { width:8rpx; height:39rpx; border-radius:8rpx; background:#1674f5; }.more { color:#98a3b4; font-size:24rpx; }
.merchant-grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:20rpx; padding:0 30rpx; }.merchant-card { overflow:hidden; border:1rpx solid #eef1f6; border-radius:18rpx; background:#fff; box-shadow:0 6rpx 16rpx rgba(27,52,91,.07); }.merchant-img{width:100%; height:172rpx; display:block;}.merchant-body{padding:17rpx 16rpx 16rpx}.merchant-name{display:block; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:28rpx; font-weight:700;margin-bottom:12rpx}.tag{display:inline-block;margin-right:7rpx;padding:5rpx 8rpx;border-radius:6rpx;background:#f0f3f7;color:#69768a;font-size:19rpx}.tag.primary{background:#e7f1ff;color:#1973ef}.score{display:block;margin-top:12rpx;color:#ff9923;font-size:20rpx}.bottom-space{height:145rpx}
