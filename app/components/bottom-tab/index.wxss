.tabbar { position: fixed; z-index: 20; bottom: 0; left: 0; right: 0; height: 112rpx; display: flex; align-items: center; justify-content: space-around; background: #fff; border-top: 1rpx solid #edf0f5; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.tab { width: 33.33%; display: flex; flex-direction: column; align-items: center; gap: 3rpx; color: #8994a9; font-size: 20rpx; }
.tab-icon { height: 39rpx; font-size: 36rpx; line-height: 39rpx; font-weight: 700; }
.tab.on { color: #1768f2; }
